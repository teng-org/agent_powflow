FROM node:20-bookworm-slim AS build

ARG APP_DIR
ARG VITE_PUBLIC_CONSOLE_ORIGIN=""
ARG VITE_PUBLIC_ADMIN_ORIGIN=""
ARG VITE_PUBLIC_KB_ORIGIN=""
ARG VITE_PUBLIC_API_ORIGIN=""
ENV VITE_PUBLIC_CONSOLE_ORIGIN=${VITE_PUBLIC_CONSOLE_ORIGIN}
ENV VITE_PUBLIC_ADMIN_ORIGIN=${VITE_PUBLIC_ADMIN_ORIGIN}
ENV VITE_PUBLIC_KB_ORIGIN=${VITE_PUBLIC_KB_ORIGIN}
ENV VITE_PUBLIC_API_ORIGIN=${VITE_PUBLIC_API_ORIGIN}
WORKDIR /app

COPY ${APP_DIR}/package*.json ./
RUN npm ci
COPY ${APP_DIR}/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY apps/nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
