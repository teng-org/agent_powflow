# Copy to .env.production, keep that file untracked, and replace every blank value.
# Generate URL-safe random values; do not reuse one value across multiple keys.
APP_ENV=production
EXECUTION_ENV=production
CHAT_PROVIDER_MODE=api_strict
WORKFLOW_PROVIDER_MODE=api_strict

# Public HTTPS origins. Do not add trailing slashes.
PUBLIC_CONSOLE_ORIGIN=https://console.example.com
PUBLIC_ADMIN_ORIGIN=https://admin.example.com
PUBLIC_KB_ORIGIN=https://kb.example.com
PUBLIC_API_ORIGIN=https://api.example.com
CONTROL_PLANE_CORS_ORIGINS=https://console.example.com,https://admin.example.com,https://kb.example.com
EXECUTION_CORS_ORIGINS=https://console.example.com,https://admin.example.com,https://kb.example.com
# Append browser-based customer application origins to CONTROL_PLANE_CORS_ORIGINS.
# Server-to-server and curl/OpenAI SDK calls do not require CORS entries.

POSTGRES_USER=
POSTGRES_PASSWORD=
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
MINIO_ROOT_ACCESS_KEY=
MINIO_ROOT_SECRET_KEY=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
MINIO_GOVERNANCE_ACCESS_KEY=
MINIO_GOVERNANCE_SECRET_KEY=
ALERTMANAGER_WEBHOOK_TOKEN=
MINIO_DOCUMENT_BUCKET=agent-powflow-documents
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_SCHEME=http
MINIO_DOCUMENT_NONCURRENT_EXPIRY_DAYS=90
MINIO_DOCUMENT_NONCURRENT_RETAIN_VERSIONS=2
# Required production logical quota per tenant (example: 10 GiB).
OBJECT_STORAGE_TENANT_QUOTA_BYTES=10737418240
OBJECT_STORAGE_QUOTA_RESERVATION_TTL_SECONDS=300
OBJECT_STORAGE_QUOTA_WARN_RATIO=0.8
OBJECT_STORAGE_CAPACITY_TENANT_LIMIT=100
INGEST_MAX_TEXT_BYTES=10485760
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_QUERY_TIMEOUT_SECONDS=3
MINIO_PHYSICAL_CAPACITY_WARN_FREE_RATIO=0.20
MINIO_PHYSICAL_CAPACITY_CRITICAL_FREE_RATIO=0.10
# Enable only when the observability Compose overlay provides PROMETHEUS_URL.
MINIO_PHYSICAL_CAPACITY_ENFORCE_WRITES=false
QDRANT_API_KEY=

EXECUTION_ADMIN_TOKEN=
EXECUTION_ADMIN_USERNAME=admin
EXECUTION_ADMIN_PASSWORD=
EXECUTION_JWT_SECRET=
EXECUTION_JWT_KEY_ID=
# Temporary kid:secret entries (maximum 3) during a JWT rotation window.
EXECUTION_JWT_PREVIOUS_KEYS=
# Required with previous keys; UTC ISO-8601, future and no more than 7 days away.
EXECUTION_JWT_PREVIOUS_KEYS_EXPIRES_AT=
# Optional legacy two-part token compatibility deadline; UTC ISO-8601, future and at most 7 days.
EXECUTION_JWT_LEGACY_ACCEPT_UNTIL=
CONTROL_PLANE_JWT_SECRET=
CONTROL_PLANE_JWT_KEY_ID=
CONTROL_PLANE_JWT_PREVIOUS_KEYS=
CONTROL_PLANE_JWT_PREVIOUS_KEYS_EXPIRES_AT=
CONTROL_PLANE_JWT_LEGACY_ACCEPT_UNTIL=
CONTROL_PLANE_INTERNAL_TOKEN=

# Fernet URL-safe base64 key encoding exactly 32 bytes.
WORKFLOW_SECRET_MASTER_KEY=
# Temporary comma-separated old Fernet keys during a coordinated rotation only.
WORKFLOW_SECRET_PREVIOUS_MASTER_KEYS=
PUBLIC_API_PORT=8088
