# Copy to .env and fill in real values locally
APP_ENV=development
LOG_LEVEL=info
# Use configured OpenAI-compatible API-pool endpoints. Set to mock only for
# deterministic offline development; never use mock for acceptance testing.
CHAT_PROVIDER_MODE=api_strict
WORKFLOW_PROVIDER_MODE=api_strict

# Unified service ports
CONTROL_PLANE_PORT=8080
EXECUTION_API_PORT=8090
DEBUG_WEB_PORT=5177
KB_ADMIN_WEB_PORT=5180
WEB_APP_PORT=5173
WEB_ADMIN_PORT=5174
POSTGRES_PORT=5432
POSTGRES_USER=apf
POSTGRES_PASSWORD=apf
POSTGRES_DB=agentpowflow
MONGODB_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_ACCESS_KEY=minioadmin
MINIO_ROOT_SECRET_KEY=minioadmin
MINIO_APP_ACCESS_KEY=apf-app-dev
MINIO_APP_SECRET_KEY=apf-app-dev-secret
MINIO_GOVERNANCE_ACCESS_KEY=apf-governance-dev
MINIO_GOVERNANCE_SECRET_KEY=apf-governance-dev-secret
MINIO_DOCUMENT_BUCKET=agent-powflow-documents
MINIO_SECURE=false
MINIO_DOCUMENT_NONCURRENT_EXPIRY_DAYS=90
MINIO_DOCUMENT_NONCURRENT_RETAIN_VERSIONS=2
CROSS_STORE_REPAIR_STALE_AFTER_SECONDS=300
CROSS_STORE_REPAIR_WARN_OPEN_COUNT=10
CROSS_STORE_REPAIR_CRITICAL_OPEN_COUNT=100
CROSS_STORE_REPAIR_WARN_AGE_SECONDS=300
CROSS_STORE_REPAIR_CRITICAL_AGE_SECONDS=1800
UPLOAD_MAX_FILES_PER_REQUEST=20
UPLOAD_MAX_BATCH_BYTES=209715200
INGEST_MAX_TEXT_BYTES=10485760
# Development default: zero disables the logical per-tenant quota.
OBJECT_STORAGE_TENANT_QUOTA_BYTES=0
OBJECT_STORAGE_QUOTA_RESERVATION_TTL_SECONDS=300
OBJECT_STORAGE_QUOTA_WARN_RATIO=0.8
OBJECT_STORAGE_CAPACITY_TENANT_LIMIT=100
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
ALERTMANAGER_WEBHOOK_TOKEN=
ALERTMANAGER_WEBHOOK_MAX_ALERTS=100
ALERTMANAGER_ALERT_RETENTION_DAYS=90
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_QUERY_TIMEOUT_SECONDS=3
MINIO_PHYSICAL_CAPACITY_WARN_FREE_RATIO=0.20
MINIO_PHYSICAL_CAPACITY_CRITICAL_FREE_RATIO=0.10
MINIO_PHYSICAL_CAPACITY_ENFORCE_WRITES=false
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Control Plane (PostgreSQL authoritative store)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agentpowflow
SPRING_DATASOURCE_USERNAME=apf
SPRING_DATASOURCE_PASSWORD=apf

# Durable approval alert evaluation and Webhook Outbox delivery.
# Leave URL/hosts blank to retain alerts in the Console without external delivery.
CONTROL_APPROVAL_ALERT_EVALUATION_ENABLED=true
CONTROL_APPROVAL_ALERT_EVALUATION_INTERVAL_MS=15000
CONTROL_APPROVAL_ALERT_DUE_SOON_SECONDS=900
CONTROL_APPROVAL_ALERT_WEBHOOK_URL=
CONTROL_APPROVAL_ALERT_ALLOWED_HOSTS=
CONTROL_APPROVAL_ALERT_ALLOW_HTTP=false
CONTROL_APPROVAL_ALERT_ALLOW_PRIVATE_NETWORK=false
CONTROL_APPROVAL_ALERT_DELIVERY_ENABLED=true
CONTROL_APPROVAL_ALERT_MAX_ATTEMPTS=8
CONTROL_APPROVAL_ALERT_REQUEST_TIMEOUT_MS=5000

# Execution Plane
MONGODB_URI=mongodb://root:root@localhost:27017/agentpowflow_execution?authSource=admin
MONGODB_DB=agentpowflow_execution
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
SILICONFLOW_API_KEY=
EXECUTION_ADMIN_TOKEN=dev-admin-token
EXECUTION_ADMIN_USERNAME=admin
EXECUTION_ADMIN_PASSWORD=admin123
EXECUTION_ADMIN_ROLE=PLATFORM_ADMIN
EXECUTION_JWT_SECRET=change-me-in-production
EXECUTION_JWT_KEY_ID=dev-primary
EXECUTION_JWT_PREVIOUS_KEYS=
EXECUTION_JWT_PREVIOUS_KEYS_EXPIRES_AT=
EXECUTION_JWT_LEGACY_ACCEPT_UNTIL=
EXECUTION_JWT_TTL_SECONDS=43200
CONTROL_PLANE_JWT_SECRET=change-me-control-in-production
CONTROL_PLANE_JWT_KEY_ID=control-dev-primary
CONTROL_PLANE_JWT_PREVIOUS_KEYS=
CONTROL_PLANE_JWT_PREVIOUS_KEYS_EXPIRES_AT=
CONTROL_PLANE_JWT_LEGACY_ACCEPT_UNTIL=
GLOBAL_KB_ID=global-kb

# Workflow HTTP tool: fail closed until explicit hosts are configured.
WORKFLOW_HTTP_ALLOWED_HOSTS=
WORKFLOW_HTTP_ALLOW_HTTP=false
WORKFLOW_HTTP_ALLOW_PRIVATE_NETWORKS=false
WORKFLOW_HTTP_MAX_RESPONSE_BYTES=1048576
WORKFLOW_HTTP_MAX_TIMEOUT_SECONDS=30
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKFLOW_SECRET_MASTER_KEY=
WORKFLOW_SECRET_PREVIOUS_MASTER_KEYS=
PUBLIC_API_PORT=8088
