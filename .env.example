# Copy to .env and fill in real values locally
APP_ENV=development
LOG_LEVEL=info

# Unified ports (single source can be generated by infra/scripts/load-service-ports.ps1)
CONTROL_PLANE_PORT=8080
EXECUTION_API_PORT=8090
DEBUG_WEB_PORT=5177
KB_ADMIN_WEB_PORT=5180
WEB_APP_PORT=5173
WEB_ADMIN_PORT=5174
POSTGRES_PORT=5432
MONGODB_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Control Plane (PostgreSQL authoritative store)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agentpowflow
SPRING_DATASOURCE_USERNAME=apf
SPRING_DATASOURCE_PASSWORD=apf

# Execution Plane
MONGODB_URI=mongodb://root:root@localhost:27017/agentpowflow_execution?authSource=admin
MONGODB_DB=agentpowflow_execution
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
SILICONFLOW_API_KEY=
EXECUTION_ADMIN_TOKEN=dev-admin-token
EXECUTION_ADMIN_USERNAME=admin
EXECUTION_ADMIN_PASSWORD=admin123
EXECUTION_ADMIN_ROLE=PLATFORM_ADMIN
EXECUTION_JWT_SECRET=change-me-in-production
EXECUTION_JWT_TTL_SECONDS=43200
GLOBAL_KB_ID=global-kb
