  "security_risk_rules": [
    {
      "id": "auth-login-fail",
      "enabled": true,
      "method": "POST",
      "path_pattern": "/api/v1/admin/auth/login",
      "risk_level": "HIGH",
      "risk_tags": [
        "auth"
      ],
      "decision": "ALERT",
      "reason_code": "AUTH_LOGIN_FAIL"
    },
    {
      "id": "config-publish",
      "enabled": true,
      "method": "POST",
      "path_pattern": "/api/v1/admin/config/publish",
      "risk_level": "HIGH",
      "risk_tags": [
        "config_change"
      ],
      "decision": "ALERT",
      "reason_code": "CONFIG_PUBLISH"
    },
    {
      "id": "config-rollback",
      "enabled": true,
      "method": "POST",
      "path_pattern": "/api/v1/admin/config/rollback",
      "risk_level": "HIGH",
      "risk_tags": [
        "config_change",
        "destructive"
      ],
      "decision": "ALERT",
      "reason_code": "CONFIG_ROLLBACK"
    },
    {
      "id": "tenant-boundary",
      "enabled": true,
      "method": "*",
      "path_pattern": "/api/v1/admin/kbs/*/bindings",
      "risk_level": "HIGH",
      "risk_tags": [
        "tenant_boundary"
      ],
      "decision": "ALERT",
      "reason_code": "TENANT_BOUNDARY_OPERATION"
    }
  ],
  "security_alert_thresholds": {
    "auth_login_fail_burst_5m": 10,
    "config_publish_burst_10m": 6,
    "tenant_boundary_burst_10m": 5
  },
